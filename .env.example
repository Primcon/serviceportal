DATABASE_URL="postgresql://vactech:vactech-dev-password@localhost:5432/vactech_service_portal?schema=public"
POSTGRES_DB="vactech_service_portal"
POSTGRES_USER="vactech"
POSTGRES_PASSWORD="vactech-dev-password"

# Optional local role switch for authorization testing. Defaults to VACTECH_MANAGER.
DEVELOPMENT_INTERNAL_ROLE="VACTECH_MANAGER"

# Set to "entra" to require verified Entra sessions locally. Defaults to development identities.
AUTH_MODE="development"

# Production identity uses separate Entra applications for customers and employees.
ENTRA_CUSTOMER_TENANT_ID=""
ENTRA_CUSTOMER_CLIENT_ID=""
ENTRA_CUSTOMER_CLIENT_SECRET=""
ENTRA_CUSTOMER_AUTHORITY=""
ENTRA_CUSTOMER_REDIRECT_URI=""
ENTRA_EMPLOYEE_TENANT_ID=""
ENTRA_EMPLOYEE_CLIENT_ID=""
ENTRA_EMPLOYEE_CLIENT_SECRET=""
ENTRA_EMPLOYEE_AUTHORITY=""
ENTRA_EMPLOYEE_REDIRECT_URI=""
AUTH_SESSION_SECRET="replace-with-at-least-32-random-characters"

# Azure Communication Services Email production delivery. Without both values,
# notifications remain recorded locally with status LOGGED.
AZURE_COMMUNICATION_SERVICES_CONNECTION_STRING=""
AZURE_COMMUNICATION_SERVICES_SENDER_ADDRESS=""
NOTIFICATION_WORKER_SECRET="replace-with-a-long-random-worker-secret"
REPORT_WORKER_SECRET="replace-with-a-different-long-random-worker-secret"
APP_ORIGIN="http://localhost:3000"
# The shop's time zone, used for times shown on server-rendered pages and the printed traveler.
APP_TIME_ZONE="America/Phoenix"

# Optional local Azure Blob Storage adapter configuration.
# Use AZURE_STORAGE_CONNECTION_STRING for local development, or use
# AZURE_STORAGE_ACCOUNT_NAME with DefaultAzureCredential / managed identity.
# Without either Azure credential, uploads use private local storage in
# .data/private-storage. Set PRIVATE_STORAGE_DIRECTORY to override it.
PRIVATE_STORAGE_DIRECTORY=""
AZURE_STORAGE_ACCOUNT_NAME=""
AZURE_STORAGE_CONTAINER_NAME="service-attachments"
AZURE_STORAGE_CONNECTION_STRING=""